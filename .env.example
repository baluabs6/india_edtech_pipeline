# Copy to .env for local development. In staging/production these are
# never set via .env — they come from Azure Key Vault through Workload
# Identity (see terraform/secrets.tf + deployment/secret-provider-class.yaml).

# ENVIRONMENT=production is the default and enforces the checks below.
# Use "development" locally to relax them (with a loud warning) if you
# don't have a full secret set.
ENVIRONMENT=**********t

# --- Required, no safe default ---
# openssl rand -hex 32
JWT_SECRET=
# Must be a DIFFERENT random value from JWT_SECRET (see config.py for why).
# openssl rand -hex 32
EXPORT_HASH_SECRET=

PG_HOST=********t
PG_PORT=***2
PG_DB=***********a
PG_USER=*******s
PG_PASSWORD=*******s

MONGO_URI=************************7
MONGO_DB=******************d

REDIS_URL=***********************0

# --- WhatsApp webhook ---
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
# Dev-only escape hatch: lets the webhook accept unsigned requests when
# WHATSAPP_APP_SECRET is blank, so you can test locally without a Meta app.
# NEVER set this to true outside a local machine.
ALLOW_UNSIGNED_WEBHOOK=****e

# --- Azure OpenAI / Language ---
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=**********i
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=*********************l
AZURE_LANGUAGE_ENDPOINT=
AZURE_LANGUAGE_KEY=

# --- Auth clients ---
# {"client_id": {"secret": "...", "state": "Bihar"}, ...}
CLIENT_CREDENTIALS_JSON=*}

# --- Alerting ---
SMTP_HOST=
SMTP_PORT=**7
SMTP_USER=
SMTP_PASSWORD=
ALERT_FROM_EMAIL=
ALERT_TO_EMAILS=
HIGH_RISK_THRESHOLD=**7
